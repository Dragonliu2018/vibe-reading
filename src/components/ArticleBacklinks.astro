---
import type { ArticleBacklink } from '../data/backlinks';

interface Props {
  backlinks: ArticleBacklink[];
  kind: 'interview' | 'reference';
}

const { backlinks, kind } = Astro.props;

const interviewGroups = kind === 'interview'
  ? [...backlinks.reduce((groups, backlink) => {
      const label = [backlink.company, backlink.team].filter(Boolean).join(' · ') || '其他来源';
      const current = groups.get(label) ?? [];
      current.push(backlink);
      groups.set(label, current);
      return groups;
    }, new Map<string, ArticleBacklink[]>())]
  : [];

const referenceArticles = kind === 'reference'
  ? [...backlinks.reduce((groups, backlink) => {
      if (!groups.has(backlink.sourceSlug)) groups.set(backlink.sourceSlug, backlink);
      return groups;
    }, new Map<string, ArticleBacklink>()).values()]
  : [];
const visibleReferences = referenceArticles.slice(0, 6);
const hiddenReferences = referenceArticles.slice(6);
---

{kind === 'interview' && backlinks.length > 0 && (
  <section class="article-backlinks interview-backlinks" aria-label="面试关联" data-pagefind-ignore="all">
    <div class="backlink-heading">
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="M7.7 12.3l4.6-4.6M6.2 15.8H4.8a3.6 3.6 0 010-7.2h2.1m6.2 0h2.1a3.6 3.6 0 010 7.2h-1.4" />
      </svg>
      <span>面试关联</span>
      <small>{backlinks.length} 次</small>
    </div>
    <div class="interview-backlink-groups">
      {interviewGroups.map(([label, records]) => (
        <details class="interview-backlink-group">
          <summary>
            <span>{label}</span>
            <small>×{records.length}</small>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" /></svg>
          </summary>
          <div class="interview-backlink-records">
            {records.map(record => (
              <a href={record.sourceHref} class="interview-backlink-record">
                <time datetime={record.occurrenceDate}>{record.occurrenceDate}</time>
                {record.round && <span class="backlink-round">{record.round}</span>}
                {record.origin && <span class:list={['backlink-origin', record.origin.toLowerCase()]}>{record.origin}</span>}
                <span class="backlink-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>
)}

{kind === 'reference' && referenceArticles.length > 0 && (
  <section class="article-backlinks reference-backlinks" aria-label="引用本文" data-pagefind-ignore="all">
    <div class="reference-backlinks-title">
      <span>引用本文</span>
      <small>{referenceArticles.length} 篇</small>
    </div>
    <ul class="reference-backlink-list">
      {visibleReferences.map(reference => (
        <li><a href={reference.sourceHref}>
          <span class="reference-backlink-name">{reference.sourceTitle}</span>
          {reference.sourceHeading && <span class="reference-backlink-context">{reference.sourceHeading}</span>}
          <span class="backlink-arrow" aria-hidden="true">↗</span>
        </a></li>
      ))}
    </ul>
    {hiddenReferences.length > 0 && (
      <details class="reference-backlinks-more">
        <summary>再显示 {hiddenReferences.length} 篇</summary>
        <ul class="reference-backlink-list">
          {hiddenReferences.map(reference => (
            <li><a href={reference.sourceHref}>
              <span class="reference-backlink-name">{reference.sourceTitle}</span>
              {reference.sourceHeading && <span class="reference-backlink-context">{reference.sourceHeading}</span>}
              <span class="backlink-arrow" aria-hidden="true">↗</span>
            </a></li>
          ))}
        </ul>
      </details>
    )}
  </section>
)}
