---
import type { Article } from '../data/articles';
import ArticleCard from './ArticleCard.astro';

export interface Props {
  items: Article[];
  page: number;
  totalPages: number;
}

const { items, page, totalPages } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageHref = (value: number) => value === 1 ? `${base}/` : `${base}/page/${value}`;
---

<main class="articles stagger" id="article-list">
  {items.map((article) => <ArticleCard article={article} animate={true} />)}
</main>

{totalPages > 1 && (
  <nav class="pagination" aria-label="文章分页" data-pagefind-ignore="all">
    {page > 1 ? <a class="page-link" href={pageHref(page - 1)}>← 上一页</a> : <span class="page-link disabled">← 上一页</span>}
    <span class="page-state">{page} / {totalPages}</span>
    {page < totalPages ? <a class="page-link" href={pageHref(page + 1)}>下一页 →</a> : <span class="page-link disabled">下一页 →</span>}
  </nav>
)}

<script>
  function initArticleList() {
    const fadeEls = document.querySelectorAll<HTMLElement>('#article-list .fade-up:not(.visible)');
    if (!('IntersectionObserver' in window)) {
      fadeEls.forEach((element) => element.classList.add('visible'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.08 });
    fadeEls.forEach((element) => observer.observe(element));
  }
  document.addEventListener('astro:page-load', initArticleList);
</script>

<style>
  .articles { display: flex; flex-direction: column; }
  .pagination { display: flex; justify-content: center; align-items: center; gap: 18px; margin-top: 28px; }
  .page-link { min-width: 92px; padding: 7px 12px; border: 1px solid var(--card-border); border-radius: 999px; color: var(--text-muted); text-align: center; font-size: 13px; }
  .page-link:hover { color: var(--text); border-color: rgba(255,255,255,.22); }
  .page-link.disabled { opacity: .3; pointer-events: none; }
  .page-state { color: var(--text-dim); font-size: 12px; font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.fade-up) { opacity: 0; transform: translateY(20px); transition: opacity .5s ease, transform .5s ease; }
    :global(.fade-up.visible) { opacity: 1; transform: translateY(0); }
    :global(.stagger > .article-card:nth-child(2)) { transition-delay: 60ms; }
    :global(.stagger > .article-card:nth-child(3)) { transition-delay: 120ms; }
    :global(.stagger > .article-card:nth-child(4)) { transition-delay: 180ms; }
    :global(.stagger > .article-card:nth-child(5)) { transition-delay: 240ms; }
    :global(.stagger > .article-card:nth-child(6)) { transition-delay: 300ms; }
    :global(.stagger > .article-card:nth-child(7)) { transition-delay: 360ms; }
    :global(.stagger > .article-card:nth-child(8)) { transition-delay: 420ms; }
  }
</style>
