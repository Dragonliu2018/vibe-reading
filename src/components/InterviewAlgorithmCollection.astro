---
import { articleBySlug } from '../data/articles';
import { getBacklinksForSlug } from '../data/backlinks';
import { encodeArticleSlug } from '../data/paths';
import type { TreeNode } from '../data/categories';

interface Props { node: TreeNode }
const { node } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function collectSlugs(current: TreeNode): string[] {
  return [
    ...(current.slugs ?? []),
    ...(current.children ?? []).flatMap(collectSlugs),
  ];
}

const entries = [...new Set(collectSlugs(node))]
  .map(slug => {
    const article = articleBySlug.get(slug);
    if (!article) return null;
    const occurrences = getBacklinksForSlug(slug)
      .filter(backlink => backlink.relation === 'direct');
    const topic = article.category.at(-1) ?? '其他';
    const isLeetCode = article.category.includes('LeetCode Hot 100')
      || article.tags.some(tag => tag.toLowerCase() === 'leetcode');
    const sourceKind = isLeetCode ? 'LeetCode' : '企业变体题';
    const organizations = [...new Set(occurrences.map(item =>
      [item.company, item.team].filter(Boolean).join(' · ') || '其他来源',
    ))];
    return { article, occurrences, topic, sourceKind, organizations };
  })
  .filter(Boolean)
  .sort((a, b) =>
    b!.occurrences.length - a!.occurrences.length
    || b!.article.date.localeCompare(a!.article.date)
    || a!.article.title.localeCompare(b!.article.title, 'zh-CN'),
  ) as {
    article: NonNullable<ReturnType<typeof articleBySlug.get>>;
    occurrences: ReturnType<typeof getBacklinksForSlug>;
    topic: string;
    sourceKind: string;
    organizations: string[];
  }[];

const organizations = [...new Set(entries.flatMap(entry => entry.organizations))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
const topics = [...new Set(entries.map(entry => entry.topic))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
---

<section class="interview-algorithm-collection" data-interview-algorithm-collection>
  <div class="algorithm-filters" aria-label="面试算法题筛选">
    <label class="algorithm-search">
      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M12.5 12.5L17 17"/></svg>
      <input type="search" placeholder="搜索题目、公司或团队" data-filter-search />
    </label>
    <label>
      <span>公司 / 团队</span>
      <select data-filter-organization>
        <option value="">全部</option>
        {organizations.map(value => <option value={value}>{value}</option>)}
      </select>
    </label>
    <label>
      <span>题型</span>
      <select data-filter-topic>
        <option value="">全部</option>
        {topics.map(value => <option value={value}>{value}</option>)}
      </select>
    </label>
    <label>
      <span>来源</span>
      <select data-filter-source>
        <option value="">全部</option>
        <option value="LeetCode">LeetCode</option>
        <option value="企业变体题">企业变体题</option>
      </select>
    </label>
    <label>
      <span>频次</span>
      <select data-filter-frequency>
        <option value="0">全部</option>
        <option value="2">至少 2 次</option>
        <option value="3">至少 3 次</option>
      </select>
    </label>
    <label>
      <span>复习</span>
      <select data-filter-reviewed>
        <option value="">全部</option>
        <option value="reviewed">已复习</option>
        <option value="pending">待复习</option>
      </select>
    </label>
  </div>

  <div class="algorithm-result-bar">
    <span>按面试出现次数排序</span>
    <span data-result-count>{entries.length} 道题</span>
  </div>

  <div class="algorithm-list">
    {entries.map(({ article, occurrences, topic, sourceKind, organizations }) => {
      const reviewed = article.reviewed === true || (typeof article.reviewed === 'number' && article.reviewed > 0);
      const search = [article.title, article.description, topic, sourceKind, ...organizations].join(' ').toLowerCase();
      return (
        <article
          class="algorithm-item"
          data-algorithm-item
          data-search={search}
          data-organizations={organizations.join('|')}
          data-topic={topic}
          data-source={sourceKind}
          data-frequency={occurrences.length}
          data-reviewed={reviewed ? 'reviewed' : 'pending'}
        >
          <div class="algorithm-frequency"><strong>{occurrences.length}</strong><span>次</span></div>
          <div class="algorithm-content">
            <div class="algorithm-title-line">
              <h2><a href={`${base}/articles/${encodeArticleSlug(article.slug)}`}>{article.title}</a></h2>
              <div class="algorithm-status">
                <span>{sourceKind}</span><span>{topic}</span>
                <span class:list={['algorithm-review', { reviewed }]}>{reviewed ? '已复习' : '待复习'}</span>
              </div>
            </div>
            {article.description && <p>{article.description}</p>}
            <div class="algorithm-occurrences">
              {occurrences.length > 0 ? occurrences.map(item => (
                  <a href={item.sourceHref}>
                    <span>{[item.company, item.team].filter(Boolean).join(' · ')}</span>
                    {item.round && <span>{item.round}</span>}
                    {item.occurrenceDate && <time datetime={item.occurrenceDate}>{item.occurrenceDate}</time>}
                    <span aria-hidden="true">↗</span>
                  </a>
                )) : <span class="algorithm-no-occurrence">暂未关联面经记录</span>}
            </div>
          </div>
        </article>
      );
    })}
  </div>
  <div class="algorithm-empty" data-filter-empty hidden>没有符合当前条件的题目</div>
</section>

<script>
  function initInterviewAlgorithmFilters() {
    const root = document.querySelector<HTMLElement>('[data-interview-algorithm-collection]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const search = root.querySelector<HTMLInputElement>('[data-filter-search]');
    const organization = root.querySelector<HTMLSelectElement>('[data-filter-organization]');
    const topic = root.querySelector<HTMLSelectElement>('[data-filter-topic]');
    const source = root.querySelector<HTMLSelectElement>('[data-filter-source]');
    const frequency = root.querySelector<HTMLSelectElement>('[data-filter-frequency]');
    const reviewed = root.querySelector<HTMLSelectElement>('[data-filter-reviewed]');
    const count = root.querySelector<HTMLElement>('[data-result-count]');
    const empty = root.querySelector<HTMLElement>('[data-filter-empty]');
    const items = [...root.querySelectorAll<HTMLElement>('[data-algorithm-item]')];

    const update = () => {
      const query = search?.value.trim().toLowerCase() ?? '';
      let visible = 0;
      for (const item of items) {
        const organizations = (item.dataset.organizations ?? '').split('|');
        const matches = (!query || (item.dataset.search ?? '').includes(query))
          && (!organization?.value || organizations.includes(organization.value))
          && (!topic?.value || item.dataset.topic === topic.value)
          && (!source?.value || item.dataset.source === source.value)
          && (Number(item.dataset.frequency ?? 0) >= Number(frequency?.value ?? 0))
          && (!reviewed?.value || item.dataset.reviewed === reviewed.value);
        item.hidden = !matches;
        if (matches) visible++;
      }
      if (count) count.textContent = `${visible} 道题`;
      if (empty) empty.hidden = visible !== 0;
    };

    root.querySelectorAll('input, select').forEach(control => {
      control.addEventListener(control instanceof HTMLInputElement ? 'input' : 'change', update);
    });
  }

  initInterviewAlgorithmFilters();
  document.addEventListener('astro:page-load', initInterviewAlgorithmFilters);
</script>

<style>
  .interview-algorithm-collection { margin-top: 4px; }
  .algorithm-filters {
    display: grid; grid-template-columns: minmax(220px, 1.6fr) repeat(5, minmax(108px, .72fr));
    gap: 8px; padding: 12px; border: 1px solid var(--border); border-radius: 12px;
    background: rgba(255,255,255,.018);
  }
  .algorithm-filters label { min-width: 0; }
  .algorithm-filters label > span {
    display: block; margin: 0 0 4px 2px; color: var(--text-dim); font-size: 10px;
  }
  .algorithm-filters input,
  .algorithm-filters select {
    width: 100%; height: 34px; border: 1px solid rgba(255,255,255,.09); border-radius: 7px;
    outline: none; color: #aaaab3; background: #0d0d10; font: inherit; font-size: 11.5px;
  }
  .algorithm-filters select { padding: 0 26px 0 9px; color-scheme: dark; }
  .algorithm-filters input { padding: 0 10px 0 31px; }
  .algorithm-filters input:focus,
  .algorithm-filters select:focus { border-color: rgba(41,151,255,.48); }
  .algorithm-search { position: relative; align-self: end; }
  .algorithm-search svg {
    position: absolute; left: 10px; bottom: 10px; width: 14px; height: 14px;
    fill: none; stroke: #5e5e66; stroke-width: 1.4; stroke-linecap: round;
  }
  .algorithm-result-bar {
    display: flex; justify-content: space-between; margin: 16px 2px 8px;
    color: var(--text-dim); font-size: 11px;
  }
  .algorithm-list { border-top: 1px solid var(--border); }
  .algorithm-item {
    display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 16px;
    padding: 19px 8px; border-bottom: 1px solid var(--border-lite);
  }
  .algorithm-item[hidden] { display: none; }
  .algorithm-frequency {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    align-self: start; width: 44px; height: 44px; border-radius: 10px;
    color: #777781; background: rgba(165,166,246,.045); border: 1px solid rgba(165,166,246,.13);
  }
  .algorithm-frequency strong { color: #b1b1c3; font-size: 16px; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .algorithm-frequency span { font-size: 9px; }
  .algorithm-content { min-width: 0; }
  .algorithm-title-line { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
  .algorithm-title-line h2 { min-width: 0; color: #c7c7ce; font-size: 15px; font-weight: 600; }
  .algorithm-title-line h2 a:hover { color: #fff; }
  .algorithm-status { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 5px; flex-shrink: 0; }
  .algorithm-status span {
    padding: 1px 6px; border: 1px solid rgba(255,255,255,.07); border-radius: 999px;
    color: #65656d; background: rgba(255,255,255,.025); font-size: 9.5px;
  }
  .algorithm-status .algorithm-review.reviewed { color: #65986f; border-color: rgba(63,185,80,.18); }
  .algorithm-content > p {
    margin-top: 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    color: #65656d; font-size: 11.5px;
  }
  .algorithm-occurrences { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .algorithm-occurrences a {
    display: inline-flex; align-items: center; gap: 6px; min-height: 25px; padding: 3px 8px;
    border-radius: 6px; color: #777780; background: rgba(255,255,255,.025);
    font-size: 10.5px; transition: color .15s, background .15s;
  }
  .algorithm-occurrences a:hover { color: #b8b8c2; background: rgba(255,255,255,.05); }
  .algorithm-occurrences a span + span,
  .algorithm-occurrences time { padding-left: 6px; border-left: 1px solid rgba(255,255,255,.08); }
  .algorithm-occurrences time { color: #5d5d65; font-family: var(--mono); font-size: 9.5px; }
  .algorithm-no-occurrence { color: #55555d; font-size: 10.5px; }
  .algorithm-empty { padding: 48px 0; text-align: center; color: var(--text-dim); font-size: 13px; }
  @media (max-width: 1000px) {
    .algorithm-filters { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .algorithm-search { grid-column: span 3; }
  }
  @media (max-width: 620px) {
    .algorithm-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .algorithm-search { grid-column: span 2; }
    .algorithm-item { grid-template-columns: 44px minmax(0, 1fr); gap: 10px; padding-inline: 2px; }
    .algorithm-frequency { width: 38px; height: 38px; }
    .algorithm-title-line { align-items: flex-start; }
    .algorithm-status span:not(.algorithm-review) { display: none; }
    .algorithm-content > p { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  }
</style>
