---
import type { TreeNode } from '../data/categories';
import type { ToolNode } from '../data/tools-tree';
import { articles, sourceLabel } from '../data/articles';
import { deriveBadges } from '../data/badges';
import { categoryTree, findActivePath, splitRootCategoryTree } from '../data/categories';
import { getToolsTree } from '../data/tools-tree';
import { encodeArticleSlug } from '../data/paths';
const reviewIcon = {
  reviewed: `<svg class="tree-review-icon" viewBox="0 0 12 12" fill="none" aria-hidden="true"><circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.3"/><path d="M3.6 6.15l1.7 1.7 3.1-3.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  pending:  `<svg class="tree-review-icon" viewBox="0 0 12 12" fill="none" aria-hidden="true"><circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.3"/><path d="M6 3.6v3.1M6 8.55h.01" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>`,
} as const;

export interface Props {
  currentSlug?: string;               // 文章模式：当前文章 slug
  mode?:        'articles' | 'tools'; // 默认 articles
  currentHref?: string;               // 工具模式：当前工具路径（如 /tools/diff）
}

const { currentSlug, mode = 'articles', currentHref } = Astro.props;
const base        = import.meta.env.BASE_URL.replace(/\/$/, '');
const activePath  = findActivePath(categoryTree, currentSlug);

/** HTML 转义 */
function esc(s: string): string {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

const chevron = `<svg class="tree-chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true">
  <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.3"
        stroke-linecap="round" stroke-linejoin="round"/>
</svg>`;

// ── 文章模式：递归渲染分类树 ──────────────────────────────────────
function renderNode(node: TreeNode, depth: number = 0): string {
  const isOpen   = activePath.has(node.key);
  const catClass = `tree-cat${depth > 0 ? ' tree-cat-sub' : ''}${isOpen ? ' open' : ''}`;
  const divClass = `tree-children${isOpen ? ' open' : ''}`;

  const childHtml   = (node.children ?? []).map(c => renderNode(c, depth + 1)).join('');
  const articleHtml = (node.slugs ?? []).map(slug => {
    const article = articles.find(a => a.slug === slug);
    const { source } = article ?? {};
    const baseTitle    = article?.title ?? slug;
    const prTypeLabel  = source?.prType ? `${source.prType}: ` : '';
    // source 前缀（统一用 articles.ts 的 sourceLabel helper）：article → [project 来源]；
    //   有 id（PR/commit）→ [project type-id]；无 id（论文解读）→ [project type]
    let displayTitle = baseTitle;
    if (source) {
      const label = sourceLabel(source, article?.categoryPath ?? []);
      if (label) displayTitle = `${label} ${prTypeLabel}${baseTitle}`;
    }
    const review = deriveBadges({ reviewed: article?.reviewed });
    const reviewMark = `<span class="tree-review-mark" data-review-state="${review.reviewState}" data-count="${review.reviewCount}" title="${esc(review.reviewTitle)}">${reviewIcon[review.reviewState]}${review.reviewCount > 1 ? `<span class="tree-review-count">×${review.reviewCount}</span>` : ''}</span>`;
    const encodedSlug = encodeArticleSlug(slug);
    const active = slug === currentSlug ? ' active' : '';
    return `<a class="tree-article${active}" href="${base}/articles/${encodedSlug}" data-tip="${esc(displayTitle)}">${reviewMark}<span class="tree-article-title">${esc(displayTitle)}</span></a>`;
  }).join('');

  return `<div class="tree-node">
  <button class="${catClass}" data-key="${esc(node.key)}" data-depth="${depth}">
    ${chevron}<span class="tree-cat-name">${esc(node.label)}</span>
  </button>
  <div class="${divClass}">${childHtml}${articleHtml}</div>
</div>`;
}

// ── 工具模式：渲染工具树 ──────────────────────────────────────────
function renderToolNode(node: ToolNode, depth: number = 0): string {
  // 叶节点：直接链接到工具页
  if (node.href) {
    const fullHref = `${base}${node.href}`;
    const active   = currentHref === node.href ? ' active' : '';
    return `<a class="tree-article${active}" href="${fullHref}">${esc(node.label)}</a>`;
  }

  // 中间节点：可折叠分组（工具较少，默认展开）
  const catClass = `tree-cat${depth > 0 ? ' tree-cat-sub' : ''} open`;
  const childHtml = (node.children ?? []).map(c => renderToolNode(c, depth + 1)).join('');

  return `<div class="tree-node">
  <button class="${catClass}" data-key="${esc(node.key)}">
    ${chevron}<span class="tree-cat-name">${esc(node.label)}</span>
  </button>
  <div class="tree-children open">${childHtml}</div>
</div>`;
}

// 注意：import.meta 只能在 frontmatter 使用（Astro 7 编译器 bug）
const showOfflineCache = mode !== 'tools' && import.meta.env.PROD;

const { publicRoots, privateRoots } = splitRootCategoryTree(categoryTree);
const publicTreeHtml  = publicRoots.map((n) => renderNode(n)).join('');
const privateTreeHtml = privateRoots.map((n) => renderNode(n)).join('');
const hasPrivateZone  = privateRoots.length > 0;
// 渲染时才建树：见 tools-tree.ts 注释（eager-glob 循环依赖，须延迟到
// 所有模块初始化完成后读取 toolMeta）
const toolTreeHtml    = getToolsTree().map(n => renderToolNode(n)).join('');
---

<!-- Sidebar：文章/工具双模式。transition:persist 让它在 ClientRouter
     客户端导航间保活：脚本绑定与交互状态（展开/宽度/滚动）持续有效 -->
<aside class="sidebar" id="g-sidebar" data-pagefind-ignore="all" transition:persist="sidebar">

  <!-- 移动端模式切换（桌面端在 nav 里，移动端在侧边栏顶部）-->
  <div class="mob-mode-toggle">
    <a href={`${base}/`}
       class:list={['mob-mode-btn', { active: mode !== 'tools' }]}>
      Articles
    </a>
    <a href={`${base}/tools`}
       class:list={['mob-mode-btn', { active: mode === 'tools' }]}>
      Tools
    </a>
  </div>

  <!-- 滚动区：树在此滚动；离线缓存区在滚动区外，永不遮挡树行 -->
  <div class="sidebar-scroll" id="g-sidebar-scroll">
    {mode === 'tools' ? (
      <>
        <p class="tree-label">Tools</p>
        <Fragment set:html={toolTreeHtml} />
      </>
    ) : (
      <>
        <div class="tree-header">
          <p class="tree-label">Categories</p>
          <button id="g-collapse-all" class="collapse-all-btn" type="button">全部折叠</button>
        </div>

        {hasPrivateZone && (
          <div class="tree-zone-divider tree-zone-divider--public" role="separator" aria-label="Public categories">
            <span class="tree-zone-divider-line" aria-hidden="true"></span>
            <span class="tree-zone-divider-label">Public</span>
            <span class="tree-zone-divider-line" aria-hidden="true"></span>
          </div>
        )}
        {publicTreeHtml && <Fragment set:html={publicTreeHtml} />}
        {hasPrivateZone && (
          <>
            <div class="tree-zone-divider tree-zone-divider--private" role="separator" aria-label="Private categories">
              <span class="tree-zone-divider-line" aria-hidden="true"></span>
              <span class="tree-zone-divider-label">Private</span>
              <span class="tree-zone-divider-line" aria-hidden="true"></span>
            </div>
            <Fragment set:html={privateTreeHtml} />
          </>
        )}
      </>
    )}
    <!-- 离线缓存控制：位于分类栏下侧、随内容滚动（滚动区 flex 尾部）。
         树短时 margin-top:auto 落在可视底部；树长时紧随树尾 —— 都不悬浮遮挡 -->
    <div class="sidebar-scroll-tail"></div>
    {showOfflineCache && (
      <div class="offline-cache-section" data-pagefind-ignore="all">
        <button id="offline-cache-btn" class="offline-cache-btn" type="button">
          <svg class="offline-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M2.5 11.5v1.5a1 1 0 001 1h9a1 1 0 001-1v-1.5"
                  stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="offline-label">离线缓存</span>
        </button>
        <div id="offline-cache-status" class="offline-cache-status"></div>
      </div>
    )}
  </div>
</aside>

<!-- 同步还原所有侧边栏状态（is:inline = 首次绘制前执行，消除闪动）-->
<script is:inline>
  (function () {
    try {
      var sidebar = document.getElementById('g-sidebar');
      if (!sidebar) return;

      // ClientRouter 客户端导航时侧边栏经 transition:persist 跨页保留，
      // 展开态/宽度/滚动位置天然延续，跳过重复还原（防止 sessionStorage 旧值跳变）
      if (sidebar.dataset.restored) return;
      sidebar.dataset.restored = '1';

      // 禁用所有过渡，防止箭头旋转、高度展开等动画在切换文章时触发
      sidebar.classList.add('no-transition');

      // 1. 还原分类展开状态
      var keys = JSON.parse(localStorage.getItem('sidebar-open-cats') || '[]');
      keys.forEach(function (key) {
        var btn = sidebar.querySelector('[data-key="' + key + '"]');
        if (btn && !btn.classList.contains('open')) {
          btn.classList.add('open');
          var list = btn.nextElementSibling;
          if (list) list.classList.add('open');
        }
      });

      // 2. 桌面端：还原宽度和折叠状态（首次绘制前完成，避免布局位移）
      if (window.matchMedia('(min-width: 960px)').matches) {
        if (localStorage.getItem('sidebar-collapsed') === 'true') {
          sidebar.classList.add('collapsed');
        }
        var savedW = localStorage.getItem('sidebar-width');
        if (savedW && !sidebar.classList.contains('collapsed')) {
          sidebar.style.width = savedW;
        }
      }

      // 3. 还原滚动区位置（首次绘制前完成，消除跨页滚动闪动）
      //    滚动元素是内层 .sidebar-scroll（外层 sidebar 不再滚动）
      var scroller = document.getElementById('g-sidebar-scroll');
      var savedScroll = sessionStorage.getItem('sidebar-scroll');
      if (scroller && savedScroll !== null) {
        scroller.scrollTop = parseInt(savedScroll, 10) || 0;
      }

      // 4. 可见性闸门：当前文章在滚动区可视范围 → 保持原位（零跳变）；
      //    不在 → 居中。仅改 scroller.scrollTop 不触发页面滚动；
      //    此时展开态已还原，测量即最终布局，且均在首帧前完成，无可见闪动
      var activeLink = sidebar.querySelector('.tree-article.active');
      if (activeLink && scroller) {
        var sRect = scroller.getBoundingClientRect();
        var lRect = activeLink.getBoundingClientRect();
        var inView = lRect.top >= sRect.top - 1 && lRect.bottom <= sRect.bottom + 1;
        if (!inView) {
          // 让 active 中线对齐滚动区中线
          scroller.scrollTop += (lRect.top + lRect.height / 2) - (sRect.top + sRect.height / 2);
        }
      }

      // 还原完毕后移除禁用类，恢复正常交互过渡
      requestAnimationFrame(function () {
        sidebar.classList.remove('no-transition');
      });
    } catch (_) {}
  })();
</script>

<!-- Mobile backdrop (click to close) -->
<div class="mob-backdrop" id="g-mob-backdrop" aria-hidden="true" transition:persist="sidebar-backdrop"></div>

<!-- Draggable divider + collapse toggle -->
<div class="resize-handle" id="g-resize-handle" transition:persist="sidebar-resize">
  <button class="sidebar-toggle" id="g-sidebar-toggle"
          title="折叠侧边栏" aria-label="折叠侧边栏">
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
      <path d="M6.5 2L3.5 5L6.5 8" stroke="currentColor" stroke-width="1.4"
            stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
</div>

<style is:global>
  /* ── Sidebar — Mobile: slide-in overlay ── */
  .sidebar {
    position: fixed;
    top: 0; left: 0;
    width: min(300px, 82vw);
    height: 100%;
    z-index: 6000;
    background: #09090e;
    border-right: 1px solid rgba(255,255,255,0.08);
    /* flex 列：滚动区 flex:1 + 缓存区固定尾部，树滚动永不滚到缓存区之下 */
    display: flex; flex-direction: column;
    overflow: hidden;
    padding: 24px 12px 16px 20px;
    transform: translateX(-100%);
    transition: transform .28s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }
  /* 滚动区：树 + 缓存区都在这里滚动（缓存区是 flex 尾部项，非悬浮层） */
  .sidebar-scroll {
    flex: 1; min-height: 0;
    display: flex; flex-direction: column;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .sidebar-scroll::-webkit-scrollbar { display: none; }
  .sidebar.mob-open { transform: translateX(0); }

  .mob-backdrop {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px);
    z-index: 5999;
    opacity: 0; transition: opacity .25s ease;
  }
  .mob-backdrop.mob-open { display: block; opacity: 1; }

  /* ── Sidebar — Desktop: inline panel ── */
  @media (min-width: 960px) {
    .sidebar {
      position: relative;
      transform: none;
      flex-shrink: 0;
      width: 240px; min-width: 120px; max-width: 480px;
      height: 100%;
      padding: 40px 12px 16px 20px;
      background: transparent; border-right: none; z-index: auto;
      transition:
        width .28s cubic-bezier(0.4, 0, 0.2, 1),
        padding .28s cubic-bezier(0.4, 0, 0.2, 1),
        min-width .28s;
    }
    .sidebar.collapsed {
      width: 0 !important; min-width: 0;
      padding-left: 0; padding-right: 0; overflow: hidden;
    }
    .mob-backdrop { display: none !important; }
  }

  /* ── Resize handle ── */
  .resize-handle { display: none; }

  @media (min-width: 960px) {
    .resize-handle {
      display: block; flex-shrink: 0; width: 12px;
      cursor: col-resize; position: relative;
      overflow: visible; background: transparent;
    }
    .resize-handle::before {
      content: ''; position: absolute; left: 5px; top: 0; bottom: 0;
      width: 1px; background: rgba(255,255,255,0.14); transition: background .18s;
    }
    .resize-handle::after {
      content: ''; position: absolute; left: 50%; top: 50%;
      transform: translate(-50%, -50%);
      width: 4px; height: 48px; border-radius: 2px;
      background: rgba(255,255,255,0); transition: background .18s, box-shadow .18s;
    }
    .resize-handle:hover::before  { background: rgba(255,255,255,0.28); }
    .resize-handle:hover::after   { background: rgba(255,255,255,0.20); }
    .resize-handle.dragging::before {
      background: rgba(41,151,255,0.7);
    }
    .resize-handle.dragging::after {
      background: rgba(41,151,255,0.45);
      box-shadow: 0 0 10px rgba(41,151,255,0.35);
    }

    /* ── Toggle button ── */
    .sidebar-toggle {
      position: absolute; top: 48px; left: 50%;
      transform: translateX(-50%);
      width: 20px; height: 20px; border-radius: 50%;
      background: #0d0d12; border: 1px solid rgba(255,255,255,0.14);
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      color: var(--text-dim); z-index: 20; padding: 0;
      opacity: 0; transition: opacity .18s, background .15s, border-color .15s, color .15s;
    }
    .resize-handle:hover .sidebar-toggle        { opacity: 1; }
    .sidebar.collapsed ~ .resize-handle .sidebar-toggle { opacity: 1; }
    .sidebar-toggle:hover {
      background: rgba(255,255,255,0.08);
      border-color: rgba(255,255,255,0.28); color: var(--text);
    }
    .sidebar-toggle svg {
      transition: transform .28s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .sidebar.collapsed ~ .resize-handle .sidebar-toggle svg {
      transform: rotate(180deg);
    }
  }

  /* ── 移动端模式切换（桌面端隐藏，手机端侧边栏顶部显示）── */
  .mob-mode-toggle {
    display: none;   /* 桌面端不需要，nav 里已有分段控件 */
  }
  @media (max-width: 959px) {
    .mob-mode-toggle {
      display: flex;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 10px;
      padding: 3px; gap: 2px;
      margin-bottom: 18px;
    }
    .mob-mode-btn {
      flex: 1; text-align: center;
      font-size: 13px; font-weight: 500;
      padding: 7px 12px; border-radius: 8px;
      color: rgba(235,235,245,0.45);
      text-decoration: none;
      transition: color .15s, background .15s;
    }
    .mob-mode-btn:hover  { color: rgba(235,235,245,0.75); }
    .mob-mode-btn.active {
      background: rgba(255,255,255,0.12);
      color: rgba(235,235,245,0.90);
    }
  }

  /* ── Section label ── */
  .tree-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 6px; padding: 0 6px;
  }
  .tree-header .tree-label { margin-bottom: 0; padding: 0; }
  .tree-label {
    font-size: 13.5px; font-weight: 700; letter-spacing: 0.4px;
    text-transform: uppercase; color: rgba(235,235,245,0.28);
    margin-bottom: 6px; padding: 0 6px;
  }
  /* 一键折叠：树头右侧的安静文字按钮 */
  .collapse-all-btn {
    border: none; background: none; cursor: pointer;
    font-family: inherit; font-size: 11px; font-weight: 500;
    color: rgba(235,235,245,0.35);
    padding: 2px 5px; border-radius: 4px;
    transition: color .12s, background .12s;
    white-space: nowrap;
  }
  .collapse-all-btn:hover { color: rgba(235,235,245,0.75); background: rgba(255,255,255,0.05); }

  /* public / private 顶层分类分隔（private 模式双区；public 模式不渲染） */
  .tree-zone-divider {
    display: flex; align-items: center; gap: 8px;
    margin: 8px 6px;
    user-select: none;
  }
  .tree-zone-divider--public  { margin-top: 2px; margin-bottom: 6px; }
  .tree-zone-divider--private { margin-top: 14px; margin-bottom: 8px; }
  .tree-zone-divider-line {
    flex: 1; height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--zone-line, rgba(255,255,255,0.12)) 20%,
      var(--zone-line, rgba(255,255,255,0.12)) 80%,
      transparent
    );
  }
  .tree-zone-divider--public {
    --zone-line: rgba(41,151,255,0.24);
    --zone-label: rgba(41,151,255,0.68);
  }
  .tree-zone-divider--private {
    --zone-line: rgba(248,81,73,0.22);
    --zone-label: rgba(248,81,73,0.62);
  }
  .tree-zone-divider-label {
    font-size: 10px; font-weight: 600; letter-spacing: 0.85px;
    text-transform: uppercase; white-space: nowrap;
    color: var(--zone-label, rgba(235,235,245,0.45));
  }

  /* ── 顶级分类之间留间隙 ── */
  .tree-node { margin-bottom: 1px; }
  /* 顶级节点（直接子元素）之间多留空气感 */
  #g-sidebar .tree-label ~ .tree-node + .tree-node { margin-top: 4px; }   /* restructure: no longer direct child */

  /* ── Category button（一级分类）── */
  .tree-cat {
    width: 100%; display: flex; align-items: center;
    padding: 5px 8px; border-radius: 6px;
    background: none; border: none; cursor: pointer;
    font-family: var(--font, -apple-system, sans-serif);
    font-size: 13px; font-weight: 600;               /* 一级：semibold */
    color: rgba(235,235,245,0.55);
    letter-spacing: -0.1px;
    transition: background .12s, color .12s;
    text-align: left; gap: 6px;
  }
  .tree-cat:hover { background: rgba(255,255,255,0.06); color: rgba(235,235,245,0.80); }
  .tree-cat.open  { color: rgba(235,235,245,0.90); }

  /* 二级及以下：常规字重，更淡 */
  .tree-cat-sub {
    font-size: 12.5px; font-weight: 500;
    color: rgba(235,235,245,0.40);
  }
  .tree-cat-sub:hover { color: rgba(235,235,245,0.65); }
  .tree-cat-sub.open  { color: rgba(235,235,245,0.78); }

  /* Chevron：与文字同色，更有整体感 */
  .tree-chevron {
    width: 10px; height: 10px; flex-shrink: 0;
    color: currentColor; opacity: 0.5;
    transition: transform .2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .tree-cat.open .tree-chevron { transform: rotate(90deg); opacity: 0.7; }

  /* 状态还原期间禁用所有子元素过渡，防止箭头/高度动画在切换文章时触发 */
  #g-sidebar.no-transition,
  #g-sidebar.no-transition * { transition: none !important; }

  .tree-cat-name { flex: 1; }

  /* ── 可折叠容器：无轨道线，纯缩进（Apple Finder 风格）── */
  .tree-children {
    overflow: hidden;
    max-height: 0;
    transition: max-height .26s cubic-bezier(0.4, 0, 0.2, 1);
    padding-left: 18px;   /* 纯缩进，不用 border-left */
  }
  .tree-children.open { max-height: 10000px; }

  /* ── 文章链接 ── */
  .tree-article {
    display: flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 400;
    color: rgba(235,235,245,0.38);
    padding: 4px 6px; border-radius: 5px;
    line-height: 1.4;
    transition: color .12s, background .12s;
  }
  .tree-article-title {
    flex: 1; min-width: 0;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .tree-review-mark {
    flex-shrink: 0; display: inline-flex; align-items: center;
    height: 12px;
  }
  .tree-review-icon { width: 12px; height: 12px; }
  /* ×N 次数：小胶囊徽章（带底色，与正文徽章语言统一），仅多次 review 出现 */
  .tree-review-count {
    font-size: 9px; font-weight: 600; line-height: 1;
    margin-left: 3px; padding: 1.5px 4px; border-radius: 6px;
    background: rgba(63,185,80,0.14);
    font-variant-numeric: tabular-nums;
    align-self: center;
  }
  .tree-review-mark[data-review-state="pending"] .tree-review-count { background: rgba(255,159,10,0.14); }
  .tree-review-mark[data-review-state="pending"]  { color: #ff9f0a; }
  .tree-review-mark[data-review-state="reviewed"] { color: #3fb950; }
  .tree-article:hover {
    color: rgba(235,235,245,0.70);
    background: rgba(255,255,255,0.05);
  }
  /* active：蓝底 + 白字（Xcode/Finder 选中标准） */
  .tree-article.active {
    color: #ffffff !important;
    background: rgba(41,151,255,0.22);
    font-weight: 500;
  }

  /* ── Mobile: 触控目标 ≥ 44px（iOS HIG 建议）── */
  @media (max-width: 959px) {
    .tree-cat     { padding: 12px 8px; font-size: 14px; }  /* ~44px */
    .tree-cat-sub { padding: 11px 8px; font-size: 13px; }  /* ~42px */
    .tree-article { padding: 11px 8px; font-size: 13px; }  /* ~42px */
    .offline-cache-btn { padding: 12px 8px; font-size: 13px; }
  }

  /* ── 离线缓存控制区（贴侧边栏可视底部）──
     sidebar 是 flex 列：树不满屏时 margin-top:auto 把它压到底；
     树超屏时它在内容末尾，sticky 钉住滚动可视底部 */
  /* 树尾哨兵：短树时被 flex 挤为 0，长树时撑出树与缓存区的呼吸间距 */
  .sidebar-scroll-tail { flex: 0 0 auto; height: 14px; }
  .offline-cache-section {
    flex-shrink: 0;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid rgba(255,255,255,0.14);
  }
  .offline-cache-btn {
    width: 100%; display: flex; align-items: center; gap: 7px;
    padding: 7px 8px; border-radius: 6px;
    background: none; border: 1px solid rgba(255,255,255,0.08);
    cursor: pointer; font-family: var(--font, -apple-system, sans-serif);
    font-size: 12.5px; font-weight: 500;
    color: rgba(235,235,245,0.50);
    transition: background .12s, color .12s, border-color .12s;
  }
  .offline-cache-btn:hover {
    background: rgba(255,255,255,0.06);
    border-color: rgba(255,255,255,0.14);
    color: rgba(235,235,245,0.75);
  }
  .offline-cache-btn:active { background: rgba(255,255,255,0.10); }
  .offline-cache-btn.downloading {
    border-color: rgba(41,151,255,0.35);
    color: rgba(41,151,255,0.80);
    cursor: progress;
  }
  .offline-cache-btn.ready {
    border-color: rgba(48,209,88,0.30);
    color: rgba(48,209,88,0.75);
  }
  .offline-icon { flex-shrink: 0; opacity: 0.7; }
  .offline-label { flex: 1; text-align: left; }

  .offline-cache-status {
    font-size: 11px; font-weight: 400;
    color: rgba(235,235,245,0.30);
    padding: 4px 8px 0; line-height: 1.4;
    display: none;
  }
  .offline-cache-status.visible { display: block; }

  /* 缓存进度条 */
  .offline-progress-bar {
    width: 100%; height: 3px; border-radius: 2px;
    background: rgba(255,255,255,0.08);
    overflow: hidden; margin-top: 6px;
  }
  .offline-progress-fill {
    height: 100%; border-radius: 2px;
    background: rgba(41,151,255,0.60);
    transition: width .2s ease;
  }

  /* ── 自定义文章标题悬浮提示 ── */
  #g-sidebar-tip {
    position: fixed;
    z-index: 9999;
    pointer-events: none;
    max-width: 360px;
    padding: 7px 13px;
    border-radius: 9px;
    background: rgba(14, 18, 28, 0.95);
    backdrop-filter: blur(24px) saturate(1.8);
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: 0 8px 32px rgba(0,0,0,0.60),
                0 2px 8px rgba(0,0,0,0.30),
                inset 0 1px 0 rgba(255,255,255,0.07);
    font-size: 12.5px;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
    color: rgba(235,235,245,0.92);
    line-height: 1.5;
    white-space: normal;
    word-break: break-all;
    opacity: 0;
    transform: scale(0.96) translateY(-50%);
    transition: opacity .14s cubic-bezier(0.2,0,0,1),
                transform .14s cubic-bezier(0.2,0,0,1);
  }
  #g-sidebar-tip.visible {
    opacity: 1;
    transform: scale(1) translateY(-50%);
  }
</style>

<script>
  const sidebar  = document.getElementById('g-sidebar')       as HTMLElement | null;
  const handle   = document.getElementById('g-resize-handle') as HTMLElement | null;
  const toggle   = document.getElementById('g-sidebar-toggle')as HTMLElement | null;
  const backdrop = document.getElementById('g-mob-backdrop')  as HTMLElement | null;

  const isDesktop = () => window.matchMedia('(min-width: 960px)').matches;

  // ── Mobile: open / close ──────────────────────────────────────────
  function openMobile() {
    sidebar?.classList.add('mob-open');
    backdrop?.classList.add('mob-open');
    document.body.style.overflow = 'hidden';
  }
  function closeMobile() {
    sidebar?.classList.remove('mob-open');
    backdrop?.classList.remove('mob-open');
    document.body.style.overflow = '';
  }
  (window as any).openMobileSidebar  = openMobile;
  (window as any).closeMobileSidebar = closeMobile;

  backdrop?.addEventListener('click', closeMobile);
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') closeMobile();
  });
  sidebar?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => { if (!isDesktop()) closeMobile(); });
  });

  // ── Always-on: category expand / collapse ─────────────────────────
  if (sidebar) {
    // 展开状态已由 <script is:inline> 在首次绘制前同步还原，此处只处理交互

    function saveOpenCats() {
      const open = Array.from(
        sidebar!.querySelectorAll<HTMLButtonElement>('.tree-cat.open')
      ).map(b => b.dataset.key ?? '').filter(Boolean);
      localStorage.setItem('sidebar-open-cats', JSON.stringify(open));
    }

    // ── 一键全部折叠 / 全部展开（展开 = 仅顶层一级，避免千余条全倾泻）──
    const collapseBtn = document.getElementById('g-collapse-all') as HTMLButtonElement | null;
    const syncCollapseLabel = () => {
      if (!collapseBtn) return;
      const anyOpen = sidebar!.querySelector('.tree-cat.open') !== null;
      collapseBtn.textContent = anyOpen ? '全部折叠' : '全部展开';
    };
    collapseBtn?.addEventListener('click', () => {
      const anyOpen = sidebar.querySelector('.tree-cat.open') !== null;
      sidebar.querySelectorAll<HTMLButtonElement>('.tree-cat').forEach(btn => {
        const list = btn.nextElementSibling as HTMLElement | null;
        if (anyOpen) {
          btn.classList.remove('open'); list?.classList.remove('open');
        } else if (btn.dataset.depth === '0') {
          btn.classList.add('open');    list?.classList.add('open');
        }
      });
      saveOpenCats();
      syncCollapseLabel();
    });
    syncCollapseLabel();   // 含 is:inline 还原后的初始态

    // 各分类独立展开/折叠
    sidebar.querySelectorAll<HTMLButtonElement>('.tree-cat').forEach(btn => {
      btn.addEventListener('click', () => {
        const isOpen = btn.classList.contains('open');
        const list   = btn.nextElementSibling as HTMLElement | null;
        btn.classList.toggle('open', !isOpen);
        list?.classList.toggle('open', !isOpen);
        saveOpenCats();
        syncCollapseLabel();
      });
    });
  }

  // 导航前保存侧边栏滚动位置，使下一页侧边栏原位不动
  window.addEventListener('pagehide', () => {
    const scroller = document.getElementById('g-sidebar-scroll');
    if (scroller) sessionStorage.setItem('sidebar-scroll', String(scroller.scrollTop));
  });

  // ── Desktop only: collapse toggle + drag to resize ───────────────
  if (sidebar && handle && toggle && isDesktop()) {
    // 宽度和折叠状态已由 is:inline 在首次绘制前还原，此处只需同步 toggle 文案
    if (sidebar.classList.contains('collapsed')) {
      toggle.title = '展开侧边栏';
      toggle.setAttribute('aria-label', '展开侧边栏');
    }

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const nowCollapsed = sidebar.classList.toggle('collapsed');
      toggle.title = nowCollapsed ? '展开侧边栏' : '折叠侧边栏';
      toggle.setAttribute('aria-label', nowCollapsed ? '展开侧边栏' : '折叠侧边栏');
      localStorage.setItem('sidebar-collapsed', String(nowCollapsed));
      if (!nowCollapsed) {
        sidebar.style.width = localStorage.getItem('sidebar-width') ?? '240px';
      }
    });

    let dragging = false, startX = 0, startW = 0;
    handle.addEventListener('mousedown', (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest('.sidebar-toggle')) return;
      if (sidebar.classList.contains('collapsed')) {
        sidebar.classList.remove('collapsed');
        localStorage.setItem('sidebar-collapsed', 'false');
      }
      dragging = true; startX = e.clientX; startW = sidebar.offsetWidth;
      handle.classList.add('dragging');
      document.body.style.cursor = 'col-resize';
      document.body.style.userSelect = 'none';
      // 拖拽期间关闭 transition，避免动画追赶鼠标导致迟钝感
      sidebar.style.transition = 'none';
      e.preventDefault();
    });
    document.addEventListener('mousemove', (e: MouseEvent) => {
      if (!dragging) return;
      sidebar.style.width = Math.min(480, Math.max(120, startW + e.clientX - startX)) + 'px';
    });
    document.addEventListener('mouseup', () => {
      if (!dragging) return;
      dragging = false;
      handle.classList.remove('dragging');
      document.body.style.cursor = '';
      document.body.style.userSelect = '';
      // 拖拽结束后恢复 transition（折叠/展开动画仍然有效）
      sidebar.style.transition = '';
      localStorage.setItem('sidebar-width', sidebar.style.width);
    });
  }

  // ── 文章标题自定义悬浮提示 ──────────────────────────────────────
  const tip = document.createElement('div');
  tip.id = 'g-sidebar-tip';
  document.body.appendChild(tip);

  let hideTimer: ReturnType<typeof setTimeout> | null = null;

  document.querySelectorAll<HTMLElement>('.tree-article[data-tip]').forEach(el => {
    el.addEventListener('mouseenter', () => {
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }

      const text = el.dataset.tip ?? '';
      tip.textContent = text;
      tip.classList.remove('visible');   // 先隐藏，无动画，让浏览器计算位置

      const rect    = el.getBoundingClientRect();
      const tipTop  = rect.top + rect.height / 2;
      let   tipLeft = rect.right + 10;

      tip.style.top   = tipTop  + 'px';
      tip.style.left  = tipLeft + 'px';
      tip.style.right = '';

      // 量出宽度判断是否越界，再触发入场动画
      requestAnimationFrame(() => {
        if (tipLeft + tip.offsetWidth > window.innerWidth - 12) {
          tip.style.left  = '';
          tip.style.right = (window.innerWidth - rect.left + 10) + 'px';
        }
        tip.classList.add('visible');
      });
    });

    el.addEventListener('mouseleave', () => {
      hideTimer = setTimeout(() => { tip.classList.remove('visible'); }, 80);
    });
  });

  // ── 离线缓存控制 ──────────────────────────────────────────────────
  (function initOfflineCache() {
    const btn = document.getElementById('offline-cache-btn') as HTMLButtonElement | null;
    const statusEl = document.getElementById('offline-cache-status');
    if (!btn || !statusEl) return;

    let isDownloading = false;

    function setLabel(text: string) {
      const span = btn.querySelector('.offline-label');
      if (span) span.textContent = text;
    }

    function showStatus(text: string, visible = true) {
      statusEl.textContent = text;
      statusEl.classList.toggle('visible', visible);
    }

    function renderProgress(done: number, total: number) {
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;
      showStatus(`缓存中… ${done}/${total} (${pct}%)`);
      // 更新进度条
      let bar = statusEl.querySelector('.offline-progress-bar') as HTMLElement | null;
      if (!bar) {
        bar = document.createElement('div');
        bar.className = 'offline-progress-bar';
        const fill = document.createElement('div');
        fill.className = 'offline-progress-fill';
        bar.appendChild(fill);
        statusEl.appendChild(bar);
      }
      const fill = bar.querySelector('.offline-progress-fill') as HTMLElement;
      if (fill) fill.style.width = pct + '%';
    }

    // 监听 SW 消息
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.addEventListener('message', (e) => {
        const msg = e.data;
        if (!msg || !msg.type) return;

        switch (msg.type) {
          case 'CACHE_START':
            isDownloading = true;
            btn.classList.add('downloading');
            btn.classList.remove('ready');
            setLabel('缓存中…');
            renderProgress(0, msg.total);
            break;
          case 'CACHE_PROGRESS':
            renderProgress(msg.done, msg.total);
            break;
          case 'CACHE_DONE':
            isDownloading = false;
            btn.classList.remove('downloading');
            btn.classList.add('ready');
            setLabel('离线已就绪');
            showStatus(`✓ 已缓存 ${msg.total} 个资源，可离线访问`);
            break;
          case 'CACHE_ERROR':
            isDownloading = false;
            btn.classList.remove('downloading');
            setLabel('离线缓存');
            showStatus(`✗ ${msg.error || '缓存失败'}`);
            break;
          case 'STATUS':
            if (msg.precacheCount > 0 && !isDownloading) {
              btn.classList.add('ready');
              setLabel('离线已就绪');
              showStatus(`✓ 已缓存 ${msg.precacheCount} 个资源`, false);
            }
            break;
          case 'CACHE_CLEARED':
            btn.classList.remove('ready', 'downloading');
            setLabel('离线缓存');
            showStatus('缓存已清空');
            setTimeout(() => showStatus('', false), 2000);
            break;
        }
      });

      // 页面加载后查询缓存状态
      navigator.serviceWorker.ready.then((reg) => {
        reg.active?.postMessage({ type: 'GET_STATUS' });
      });
    }

    // 按钮点击：未缓存→开始缓存；已缓存→长按清空（单击显示状态）
    let clickTimer: ReturnType<typeof setTimeout> | null = null;
    btn.addEventListener('click', () => {
      if (isDownloading) return;

      if (btn.classList.contains('ready')) {
        // 已缓存：单击显示状态，双击清空
        if (clickTimer) {
          // 双击 → 清空
          clearTimeout(clickTimer);
          clickTimer = null;
          if (confirm('确认清空所有离线缓存？')) {
            navigator.serviceWorker.controller?.postMessage({ type: 'CLEAR_CACHE' });
            btn.classList.remove('ready');
            setLabel('离线缓存');
          }
        } else {
          clickTimer = setTimeout(() => {
            clickTimer = null;
            showStatus('双击可清空缓存', true);
            setTimeout(() => {
              if (!isDownloading) {
                const ready = btn.classList.contains('ready');
                showStatus(ready ? '✓ 离线缓存就绪' : '', ready);
              }
            }, 2500);
          }, 250);
        }
      } else {
        // 未缓存：触发全站缓存
        if (!('serviceWorker' in navigator) || !navigator.serviceWorker.controller) {
          showStatus('Service Worker 尚未就绪，请刷新页面重试');
          return;
        }
        navigator.serviceWorker.controller.postMessage({ type: 'CACHE_ALL' });
      }
    });
  })();
</script>
