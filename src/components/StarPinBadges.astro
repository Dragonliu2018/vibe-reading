---
/**
 * star / pin 徽章 — 紧凑行语境的统一徽章（收藏视图等与列表 view 一致展示）
 *
 * 与 ArticleBadges 的 .star-badge / .pin-badge 同类同色（金色族），
 * 尺寸按行内 meta 语境（10px，与 badge-cat 一致）。
 * 样式由引用页作用域提供（favorites.astro 的 :global 规则）。
 */
export interface Props {
  type: 'star' | 'pin';
}

const { type } = Astro.props;
---

{type === 'star' ? (
  <span class="star-badge" title="收藏的好文">⭐ 收藏</span>
) : (
  <span class="pin-badge" title="置顶文章">📌 置顶</span>
)}
