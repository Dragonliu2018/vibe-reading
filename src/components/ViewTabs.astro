---
/**
 * 视图切换 tab 条——列表 / 时间线 / 活跃度 / 徽章。
 *
 * 每个视图是独立静态页面，切换 = <a> 链接跳转（同 NavBar Articles/Tools 模式）。
 * 样式复用首页 .filter-tabs 的胶囊风格；用 is:global 让所有引用页共享同一套 CSS。
 * count：可选，显示在 tab 行右端的安静总数（当前仅列表视图使用）。
 */
export type ViewKey = 'list' | 'favorites' | 'review' | 'timeline' | 'activity' | 'badges';

interface Props {
  active: ViewKey;
  count?: number;
}

const { active, count } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tabs: { key: ViewKey; label: string; href: string }[] = [
  { key: 'list',      label: '列表',   href: `${base}/`          },
  { key: 'favorites', label: '收藏',   href: `${base}/favorites` },
  { key: 'review',    label: 'Reviewed', href: `${base}/review`  },
  { key: 'timeline',  label: '时间线', href: `${base}/timeline`  },
  { key: 'activity',  label: '活跃度', href: `${base}/activity`  },
  { key: 'badges',    label: '徽章',   href: `${base}/badges`    },
];
---

<nav class="view-tabs" aria-label="视图切换">
  {tabs.map(t => (
    <a href={t.href} class={`view-tab${t.key === active ? ' active' : ''}`} aria-current={t.key === active ? 'page' : undefined}>
      {t.label}
    </a>
  ))}
  {typeof count === 'number' && <span class="view-tabs-count">{count} 篇</span>}
</nav>

<style is:global>
  .view-tabs {
    display: flex; flex-wrap: wrap; align-items: center;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 3px; gap: 2px;
    margin-bottom: 24px;
    max-width: 100%;
  }
  .view-tab {
    font-size: 13.5px; font-weight: 500;
    padding: 6px 16px; border-radius: 8px;
    color: #86868b;
    cursor: pointer; border: none; background: none;
    transition: color .15s, background .15s;
    text-decoration: none; white-space: nowrap;
    font-family: inherit; line-height: 1.4;
  }
  .view-tab:hover { color: #f5f5f7; }
  .view-tab.active { background: rgba(255,255,255,0.09); color: #f5f5f7; }
  /* 总数：tab 行右端的计数胶囊（同 badges 分组 count 的视觉重量） */
  .view-tabs-count {
    margin-left: auto;
    font-size: 12px; font-weight: 500; color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    background: rgba(255,255,255,0.06);
    border-radius: 20px;
    padding: 2px 9px;
    white-space: nowrap;
  }
</style>
