---
import { articles, sourceLabel, badgeCat } from '../data/articles';
import Sidebar from '../components/Sidebar.astro';
import SearchModal from '../components/SearchModal.astro';
import NavBar from '../components/NavBar.astro';
import GiscusComments from '../components/GiscusComments.astro';
import SWRegister from '../components/SWRegister.astro';
import ScrollRestore from '../components/ScrollRestore.astro';
import '../styles/article.css';
import 'katex/dist/katex.min.css';

export interface Props {
  frontmatter: {
    title:        string;
    date:         string;
    category?:    string[];   // 层级路径；最后一项用作徽章
    tags?:        string[];
    description?: string;
    readingTime?: string;
    aiModel?:     string;
    reviewed?:    boolean;
    source?: {
      project: string;        // 项目名，如 Doris / ClickHouse
      type:    string;        // 引用类型，如 PR / Issue / RFC / arxiv / commit
      id:      string;        // 编号，如 26133
      url?:    string;        // 可选：原始链接
      prType?: 'feat' | 'perf' | 'enhancement' | 'fix' | 'refactor';
    };
  };
  headings?: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings = [] } = Astro.props;
const { title, date, category, tags = [], description, readingTime, aiModel, source, reviewed } = frontmatter;

// source 前缀（统一用 articles.ts 的 sourceLabel helper，避免 4 处副本漂移）
const srcLabel    = source ? sourceLabel(source, category ?? []) : '';
const hasSourceLabel = !!srcLabel;
const prTypeLabel  = source?.prType ? `${source.prType}: ` : '';
const displayTitle = hasSourceLabel ? `${srcLabel} ${prTypeLabel}${title}` : title;

const base     = import.meta.env.BASE_URL.replace(/\/$/, '');
const catLabel = badgeCat(category);

// 沉浸式阅读模式：文学 / 电影 / 历史 等非技术题材使用衬线字体 + 疏朗排版
const LITERARY_DOMAINS = ['Literature', 'Cinema', 'History'];
const firstCat   = category?.[0] ?? '';
const layoutMode = LITERARY_DOMAINS.includes(firstCat) ? 'literary' : 'default';

// 与首页保持一致：按全站标签首次出现顺序分配颜色，保证相同标签全站同色
// 仅用蓝紫系——绿/橙黄留给 review-badge、粉/teal 留给 origin-badge，三类徽章色域不重合
const BADGE_PALETTE = [
  { text: '#58a6ff', bg: 'rgba(88,166,255,.12)',  border: 'rgba(88,166,255,.30)'  },
  { text: '#bc8cff', bg: 'rgba(188,140,255,.12)', border: 'rgba(188,140,255,.30)' },
  { text: '#7aa2f7', bg: 'rgba(122,162,247,.12)', border: 'rgba(122,162,247,.30)' },
  { text: '#d2a8ff', bg: 'rgba(210,168,255,.12)', border: 'rgba(210,168,255,.30)' },
] as const;
const catCountMap = articles.reduce<Record<string, number>>((acc, a) => {
  const last = badgeCat(a.category);
  if (last) acc[last] = (acc[last] ?? 0) + 1;
  return acc;
}, {});
const allCats = Object.entries(catCountMap).sort((a, b) => b[1] - a[1]).map(([l]) => l);
const catColorMap = new Map(allCats.map((label, i) => [label, BADGE_PALETTE[i % BADGE_PALETTE.length]]));
function badgeStyle(label: string): string {
  const col = catColorMap.get(label) ?? BADGE_PALETTE[0];
  return `color:${col.text};background:${col.bg};border:1px solid ${col.border};`;
}

// Derive slug from URL to highlight current article in sidebar
const pathname    = Astro.url.pathname;
const currentSlug = pathname.replace(/.*\/articles\//, '').replace(/\/$/, '');

// 源文件路径（用于跳转到 IDE 查看对应文件）
const sourceFilePath = `src/pages/articles/_md/${currentSlug}.md`;
// 生产环境 GitHub 链接
const githubSourceUrl = `https://github.com/Dragonliu2018/vibe-reading/blob/main/${sourceFilePath}`;
// 构建时获取项目根目录绝对路径（用于 localhost 跳转 VS Code）
const projectRoot = process.cwd();
// 本地 VS Code 链接
const vscodeSourceUrl = `vscode://file${projectRoot}/${sourceFilePath}`;

// Reviewed 徽章：静态判定，依据文章 frontmatter 的 reviewed 字段。构建期决定，无运行时。
const isReviewed = !!reviewed;
const reviewState = isReviewed ? 'reviewed' : 'pending';
const reviewLabel = isReviewed ? 'Reviewed' : 'Draft';
const reviewTitle = isReviewed ? '已人工 review' : 'AI 初稿，待人工 review';

// Origin 徽章：转载（source.type=article）vs AI 生成内容（PR 解读/源码解读/论文等）
const isRepost = source?.type === 'article';
const originState = isRepost ? 'repost' : 'original';
const originLabel = isRepost ? '转载' : 'AI 生成';
const originTitle = isRepost ? '转载自外部文章' : 'AI 生成内容';

// TOC: h2 + h3 + h4 only
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3 || h.depth === 4);
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{displayTitle} · Vibe Reading</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <SWRegister />
  {layoutMode === 'literary' && (
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  )}
  {layoutMode === 'literary' && (
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  )}
  {layoutMode === 'literary' && (
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;700&display=swap" />
  )}
</head>
<body data-layout={layoutMode}>

  <div id="progress-bar" data-pagefind-ignore="all"></div>

  <NavBar mode="articles" showBack={true} />

  <div class="layout">

    <!-- 左侧：分类树 -->
    <Sidebar currentSlug={currentSlug} />

    <!-- 常驻目录：Categories 右侧，文章左边 -->
    {tocHeadings.length > 0 && (
      <>
        <aside id="g-toc-panel" class="article-toc-panel" data-pagefind-ignore="all">
          <p class="toc-heading">目录</p>
          <ul class="toc-list">
            {tocHeadings.map(h => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class:list={['toc-link', `depth-${h.depth}`]}
                  title={h.text}
                >{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>

        <!-- TOC 折叠 handle -->
        <div id="g-toc-handle" class="toc-handle">
          <button id="g-toc-toggle" class="toc-toggle"
                  title="折叠目录" aria-label="折叠目录">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
              <path d="M6.5 2L3.5 5L6.5 8" stroke="currentColor" stroke-width="1.4"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </>
    )}

    <!-- 正文 -->
    <div class="main-scroll">
      <div class="article-col">

        <header class="article-header">
          <div class="article-meta">
            {catLabel && (
              <span class="cat-badge" style={badgeStyle(catLabel)}>
                {catLabel}
              </span>
            )}
            <span class="origin-badge"
                  data-origin={originState}
                  title={originTitle}>{originLabel}</span>
            <span class="review-badge"
                  data-review-state={reviewState}
                  title={reviewTitle}>{reviewLabel}</span>
            {date        && <><span class="meta-sep">·</span><span class="meta-item">{date.slice(0, 10)}</span></>}
            {readingTime && <><span class="meta-sep">·</span><span class="meta-item">{readingTime}</span></>}
            {aiModel     && <><span class="meta-sep">·</span><span class="meta-item">{aiModel}</span></>}
          </div>

          <h1 class="article-title" data-pagefind-meta="title">
            {hasSourceLabel && <span class="source-label">{srcLabel}</span>}
            {source?.prType && <span class="pr-type-label"> {source.prType}:</span>}
            {hasSourceLabel ? ` ${title}` : title}
          </h1>
          {description && <p class="article-desc">{description}</p>}

          {tags.length > 0 && (
            <div class="article-tags">
              {tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          )}
        </header>

        <div class="article-divider"></div>

        <article class="prose">
          {category && category.length > 1 && (
            <nav class="category-breadcrumb" aria-label="分类路径" data-pagefind-ignore>
              <a href={`${base}/`} class="bc-home">首页</a>
              {category.map((cat, i) => (
                <>
                  <span class="bc-sep">›</span>
                  <a
                    href={`${base}/categories/${category!.slice(0, i + 1).map(encodeURIComponent).join('/')}`}
                    class={`bc-item${i === category.length - 1 ? ' bc-current' : ''}`}
                  >{cat}</a>
                </>
              ))}
            </nav>
          )}
          {source?.url && (
            <div class="article-source-path" data-pagefind-ignore="all">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" style="flex-shrink:0;opacity:0.5">
                <path d="M1 4.75C1 3.784 1.784 3 2.75 3h10.5c.966 0 1.75.784 1.75 1.75v6.5A1.75 1.75 0 0113.25 13H2.75A1.75 1.75 0 011 11.25v-6.5zm1.75-.25a.25.25 0 00-.25.25v6.5c0 .138.112.25.25.25h10.5a.25.25 0 00.25-.25v-6.5a.25.25 0 00-.25-.25H2.75z"/>
                <path d="M4 5.75A.75.75 0 014.75 5h6.5a.75.75 0 010 1.5h-6.5A.75.75 0 014 5.75zM4 8a.75.75 0 01.75-.75h3.5a.75.75 0 010 1.5h-3.5A.75.75 0 014 8z"/>
              </svg>
              <a href={githubSourceUrl} target="_blank" rel="noopener" class="source-path-link" data-vscode-url={vscodeSourceUrl}>{sourceFilePath}</a>
            </div>
          )}
          <slot />
        </article>

        <GiscusComments />

      </div>

      <footer class="footer" data-pagefind-ignore="all">
        Vibe Reading · AI-drafted · Human-reviewed &nbsp;·&nbsp;
        <a href={`${base}/`}>← 返回首页</a> &nbsp;·&nbsp;
        <a href="https://github.com/Dragonliu2018/vibe-reading" target="_blank" rel="noopener">GitHub</a>
      </footer>
    </div>

  </div>

  <ScrollRestore />

  <!-- 首次绘制前还原目录栏宽度/折叠状态，避免布局位移 -->
  <script is:inline>
    (function () {
      try {
        var panel = document.getElementById('g-toc-panel');
        if (!panel || !window.matchMedia('(min-width: 960px)').matches) return;
        if (localStorage.getItem('toc-collapsed') === 'true') {
          panel.classList.add('collapsed');
        }
        var savedW = localStorage.getItem('toc-width');
        if (savedW && !panel.classList.contains('collapsed')) {
          panel.style.width = savedW;
        }
      } catch (_) {}
    })();
  </script>

  <script is:inline set:html={`
    // 源文件路径点击：localhost 复制路径到剪贴板，生产环境跳转 GitHub
    // TODO: 优化 VS Code Simple Browser 内部跳转——当前 Simple Browser 拦截所有 vscode:// 协议导航，
    //   无法直接从 webview 内打开文件。未来可探索 VS Code 扩展 API（acquireVsCodeApi postMessage）
    //   或自定义 Simple Browser 扩展来实现直接跳转。
    (function () {
      var link = document.querySelector('a.source-path-link[data-vscode-url]');
      if (!link) return;
      // 仅在本地开发环境（localhost）修改行为
      if (!location.hostname.match(/^(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0)$/)) return;
      // VS Code Simple Browser 拦截所有 vscode:// 协议导航，无法直接跳转
      // 改为复制文件路径到剪贴板，用户 Cmd+P 粘贴打开
      var filePath = link.textContent.trim();
      link.removeAttribute('target');
      link.removeAttribute('rel');
      link.href = '#';
      link.title = '点击复制路径，然后在 VS Code 中 Cmd+P 粘贴打开';
      link.addEventListener('click', function (e) {
        e.preventDefault();
        navigator.clipboard.writeText(filePath).then(function () {
          var orig = link.textContent;
          link.textContent = '已复制! Cmd+P 粘贴打开 →';
          link.style.color = '#3fb950';
          setTimeout(function () {
            link.textContent = orig;
            link.style.color = '';
          }, 2000);
        });
      });
    })();
  `}>
  </script>

  <script>
    import '../scripts/article-toc';
  </script>
  <script>
    import '../scripts/code-block';
  </script>
  <script is:inline>
    // 把独立图片段落 <p><img alt="x"></p> 包成
    // <figure class="image-figure"><img><figcaption>x</figcaption></figure>
    // 让 markdown alt 作为图注显示并居中（Sätteri 不支持 rehype 插件，改客户端内联处理）
    (function () {
      document.querySelectorAll('.prose img').forEach(function (img) {
        var p = img.parentElement;
        if (!p || p.tagName !== 'P') return;
        if (p.children.length !== 1 || p.children[0] !== img) return;
        if (img.closest('figure.image-figure')) return;
        var alt = (img.getAttribute('alt') || '').trim();
        var fig = document.createElement('figure');
        fig.className = 'image-figure';
        fig.appendChild(img);
        if (alt) {
          var fc = document.createElement('figcaption');
          fc.textContent = alt;
          fig.appendChild(fc);
        }
        p.replaceWith(fig);
      });
      // 图片点击放大（lightbox）：滚轮/双指缩放图片本身（阻止页面缩放）、拖拽、ESC/空白关闭
      function openLightbox(src, alt) {
        var o = document.createElement('div');
        o.className = 'img-lightbox';
        var b = document.createElement('img');
        b.src = src; if (alt) b.alt = alt;
        o.appendChild(b);
        var scale = 1, tx = 0, ty = 0, drag = false, sx, sy, ox, oy;
        function apply() { b.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + scale + ')'; }
        function onMove(e) { if (!drag) return; tx = ox + e.clientX - sx; ty = oy + e.clientY - sy; apply(); }
        function onUp() { drag = false; }
        function onKey(e) { if (e.key === 'Escape') close(); }
        function close() {
          o.remove(); document.body.style.overflow = '';
          window.removeEventListener('mousemove', onMove);
          window.removeEventListener('mouseup', onUp);
          window.removeEventListener('keydown', onKey);
        }
        o.addEventListener('wheel', function (e) {
          e.preventDefault();
          // 按 deltaY 对数衰减缩放：小滑小变、大滑衰减，避免一滑暴增
          var factor = Math.exp(-e.deltaY * 0.012);
          scale = Math.max(1, Math.min(8, scale * factor));
          if (scale === 1) { tx = 0; ty = 0; }
          apply();
        }, { passive: false });
        b.addEventListener('mousedown', function (e) { drag = true; sx = e.clientX; sy = e.clientY; ox = tx; oy = ty; e.preventDefault(); });
        window.addEventListener('mousemove', onMove);
        window.addEventListener('mouseup', onUp);
        o.addEventListener('click', function (e) { if (e.target === o) close(); });
        // 双击图片：以点击位置为锚放大到 2.5×，再次双击复原
        b.addEventListener('dblclick', function (e) {
          e.preventDefault(); e.stopPropagation();
          if (scale === 1) {
            var S = 2.5;
            var r = o.getBoundingClientRect();
            var dx = e.clientX - (r.left + r.width / 2);
            var dy = e.clientY - (r.top + r.height / 2);
            scale = S; tx = dx * (1 - S); ty = dy * (1 - S);
          } else {
            scale = 1; tx = 0; ty = 0;
          }
          apply();
        });
        // 触摸手势（移动端）：单指拖拽（scale>1 时）、双指捏合缩放、双击放大
        var lastTap = 0, tapX = 0, tapY = 0;
        var tDrag = false, tSx = 0, tSy = 0, tOx = 0, tOy = 0;
        var pinchD0 = 0, pinchS0 = 1;
        function tDist(ts) {
          var dx = ts[0].clientX - ts[1].clientX, dy = ts[0].clientY - ts[1].clientY;
          return Math.sqrt(dx * dx + dy * dy);
        }
        b.addEventListener('touchstart', function (e) {
          if (e.touches.length === 1) {
            var t = e.touches[0], now = Date.now();
            if (now - lastTap < 300 && Math.abs(t.clientX - tapX) < 30 && Math.abs(t.clientY - tapY) < 30) {
              // 双击：以点击点为锚放大到 2.5× 或复原
              e.preventDefault();
              if (scale === 1) {
                var S = 2.5, r = o.getBoundingClientRect();
                scale = S; tx = (t.clientX - (r.left + r.width / 2)) * (1 - S);
                ty = (t.clientY - (r.top + r.height / 2)) * (1 - S);
              } else { scale = 1; tx = 0; ty = 0; }
              apply(); lastTap = 0;
            } else {
              lastTap = now; tapX = t.clientX; tapY = t.clientY;
              if (scale > 1) { tDrag = true; tSx = t.clientX; tSy = t.clientY; tOx = tx; tOy = ty; }
            }
          } else if (e.touches.length === 2) {
            tDrag = false; pinchD0 = tDist(e.touches); pinchS0 = scale;
          }
        }, { passive: false });
        b.addEventListener('touchmove', function (e) {
          e.preventDefault();
          if (e.touches.length === 1 && tDrag) {
            var t = e.touches[0];
            tx = tOx + t.clientX - tSx; ty = tOy + t.clientY - tSy; apply();
          } else if (e.touches.length === 2 && pinchD0 > 0) {
            scale = Math.max(1, Math.min(8, pinchS0 * (tDist(e.touches) / pinchD0)));
            if (scale === 1) { tx = 0; ty = 0; }
            apply();
          }
        }, { passive: false });
        b.addEventListener('touchend', function (e) {
          if (e.touches.length === 0) tDrag = false;
          if (e.touches.length < 2) pinchD0 = 0;
        });
        window.addEventListener('keydown', onKey);
        document.body.appendChild(o);
        document.body.style.overflow = 'hidden';
      }
      document.querySelectorAll('.prose img').forEach(function (img) {
        img.style.cursor = 'zoom-in';
        img.addEventListener('click', function () {
          openLightbox(img.currentSrc || img.src, img.getAttribute('alt'));
        });
      });
    })();
  </script>

  <!-- 桌面端：回到顶部 -->
  <button id="back-to-top" class="back-to-top" aria-label="回到顶部" title="回到顶部" data-pagefind-ignore="all">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M8 13V3M3 8l5-5 5 5" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <!-- 移动端目录：右下角按钮 + 左侧滑入面板 -->
  {tocHeadings.length > 0 && (
    <>
      <!-- 右下角圆形按钮 -->
      <button id="mob-toc-tab" class="mob-toc-tab" data-state="toc"
              aria-label="查看目录" data-pagefind-ignore="all">
        <!-- 目录图标（Notion 风格大纲线）-->
        <span class="tab-icon tab-icon-toc" aria-hidden="true">
          <svg width="14" height="13" viewBox="0 0 14 13" fill="none">
            <path d="M0 1h14"      stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M2.5 5h11.5"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M2.5 9h9"     stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M0 13h14"     stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </span>
        <!-- 回顶图标（向上箭头）-->
        <span class="tab-icon tab-icon-top" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path d="M8 13V3M3 8l5-5 5 5" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </button>

      <!-- 遮罩 -->
      <div id="mob-toc-backdrop" class="mob-toc-backdrop" aria-hidden="true"></div>

      <!-- 侧滑面板 -->
      <div id="mob-toc-panel" class="mob-toc-panel" role="dialog" aria-label="文章目录" data-pagefind-ignore="all">
        <div class="mob-toc-panel-head">
          <p class="mob-toc-panel-title">目录</p>
          <button id="mob-toc-close" class="mob-toc-panel-close" aria-label="关闭目录">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
        <ul class="mob-toc-list">
          {tocHeadings.map(h => (
            <li>
              <a href={`#${h.slug}`}
                 class:list={['mob-toc-link', `depth-${h.depth}`]}
                 data-id={h.slug}
                 title={h.text}>
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </>
  )}

  <SearchModal />

</body>
</html>
