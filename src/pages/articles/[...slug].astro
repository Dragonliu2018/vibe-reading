---
/**
 * 统一文章路由
 *
 * 源文件目录（_ 前缀 = Astro 不自动建路由）：
 *   _html/  HTML 文章（渲染为 HtmlArticleLayout + iframe）
 *   _md/    Markdown 文章（import.meta.glob 渲染为 ArticleLayout）
 *
 * 最终 URL 全部统一为 /articles/[...slug]
 * 支持 _md/ 下的子目录（如 _md/myproject/00-overview.md → /articles/myproject/00-overview）
 */
import { readdirSync } from 'fs';
import HtmlArticleLayout from '../../layouts/HtmlArticleLayout.astro';
import ArticleLayout     from '../../layouts/ArticleLayout.astro';
import { articles as articlesMeta } from '../../data/articles';

// 所有 MD 模块（递归匹配子目录）——模块级声明，渲染时使用
const mdModules = import.meta.glob('./_md/**/*.md');

export function getStaticPaths() {
  const htmlFiles = readdirSync('./src/pages/articles/html')
    .filter(f => f.endsWith('.html'))
    .map(f => f.slice(0, -5));           // 真实文件名（不含扩展名）

  // 从 import.meta.glob 的 key 提取 slug（相对 _md/ 的路径，去 .md）
  const allMdPaths = import.meta.glob('./_md/**/*.md');
  const mdSlugs = new Set(
    Object.keys(allMdPaths).map(p => p.replace('./_md/', '').replace(/\.md$/, ''))
  );

  return [
    // HTML 文章：与 MD 同名时自动追加 -html，文件名保持不变
    ...htmlFiles.map(file => {
      const slug = mdSlugs.has(file) ? `${file}-html` : file;
      return { params: { slug }, props: { format: 'html', htmlFile: file } };
    }),
    // MD 文章：slug 可能含 /（子目录），rest 参数传字符串
    ...[...mdSlugs].map(slug => {
      return { params: { slug }, props: { format: 'md', mdSlug: slug } };
    }),
  ];
}

const { slug }              = Astro.params;      // rest 参数：string | string[]
const { format, htmlFile, mdSlug } = Astro.props;
const base       = import.meta.env.BASE_URL.replace(/\/$/, '');

// 将 rest 参数还原为扁平 slug
const flatSlug = Array.isArray(slug) ? slug.join('/') : slug;

// MD：通过 import.meta.glob 加载模块，渲染 Content 组件
let Content:     any;
let headings:    any[] = [];
let frontmatter: any   = {};

if (format === 'md') {
  const loader = mdModules[`./_md/${flatSlug}.md`];
  if (loader) {
    const mod  = await loader() as any;
    Content    = mod.default;
    headings   = mod.getHeadings?.() ?? [];
    const meta = articlesMeta.find(a => a.slug === flatSlug || a.slug === mdSlug);
    frontmatter = {
      ...mod.frontmatter,
      category:    mod.frontmatter?.category    ?? meta?.category,
      readingTime: mod.frontmatter?.readingTime ?? meta?.readingTime,
      aiModel:     mod.frontmatter?.aiModel     ?? meta?.aiModel,
    };
  }
}
---

{format === 'html'
  ? <HtmlArticleLayout slug={htmlFile} iframeSrc={`${base}/articles/html/${htmlFile}`} />
  : <ArticleLayout frontmatter={frontmatter} headings={headings}><Content /></ArticleLayout>
}
