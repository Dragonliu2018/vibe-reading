---
/**
 * 徽章视图 — 以徽章为主体分组展示文章
 *
 * 构建时渲染，前端零数据逻辑。一个徽章 = 一个折叠组：
 *   分类（badgeCat 派生，复用全站调色板）/ 来源 / Review / 源类型（source.type，新启用）。
 * 置顶不设维度——4 篇置顶在列表首屏即见，"普通(917)" 是噪音；
 * 置顶状态在组内行级以 📌 前缀体现。
 * 分组头复用 ArticleBadges 的既有徽章类（is:global），不再维护 inline style 副本。
 */
import { articles, type Article } from '../data/articles';
import { deriveBadges, badgeStyle } from '../data/badges';
import BaseLayout from '../layouts/BaseLayout.astro';
import ViewTabs from '../components/ViewTabs.astro';
import ArticleRow from '../components/ArticleRow.astro';

const totalArticles = articles.length;

// ── 分组结构 ─────────────────────────────────────────────────────
// kind: 渲染分组头徽章的方式
//   badge  → 复用 ArticleBadges 徽章类 + data 属性着色（origin/review）
//   inline → badgeStyle() inline style（分类，全站频次调色板）
//   plain  → 灰色胶囊（源类型：无对应站点徽章）
interface Group {
  key:   string;                  // 稳定排序键（data-origin 等）
  label: string;
  kind:  'badge' | 'inline' | 'plain';
  count: number;
  items: Article[];
}
interface Dimension {
  title: string;
  groups: Group[];
}

function groupBy(
  get: (a: Article) => { key: string; label: string },
  opts: { kind: Group['kind']; orderByLabel?: boolean } = { kind: 'plain' }
): Group[] {
  const map = new Map<string, { label: string; items: Article[] }>();
  for (const a of articles) {
    const { key, label } = get(a);
    if (!map.has(key)) map.set(key, { label, items: [] });
    map.get(key)!.items.push(a);
  }
  return [...map.entries()]
    .sort((x, y) => y[1].items.length - x[1].items.length)
    .map(([key, { label, items }]) => ({ key, label, kind: opts.kind, count: items.length, items }));
}

const artBadges = new Map(articles.map(a => [a.slug, deriveBadges(a)]));

// 源类型中文标签（source.type 直出，构建站点已有语料：源码解读/PR/论文解读/commit/article）
const SOURCE_TYPE_LABELS: Record<string, string> = {
  'article': '转载',
};

const dimensions: Dimension[] = [
  {
    title: '按分类',
    groups: groupBy(
      a => ({ key: `cat:${artBadges.get(a.slug)!.catLabel || '未分类'}`, label: artBadges.get(a.slug)!.catLabel || '未分类' }),
      { kind: 'inline' }
    ),
  },
  {
    title: '按来源',
    groups: groupBy(
      a => ({ key: `origin:${artBadges.get(a.slug)!.originState}`, label: artBadges.get(a.slug)!.originLabel }),
      { kind: 'badge' }
    ),
  },
  {
    title: '按 Review',
    groups: groupBy(
      a => ({ key: `review:${artBadges.get(a.slug)!.reviewState}`, label: artBadges.get(a.slug)!.reviewLabel }),
      { kind: 'badge' }
    ),
  },
  {
    title: '按源类型',
    groups: groupBy(
      a => {
        const t = a.source?.type ?? '';
        return { key: `stype:${t}`, label: SOURCE_TYPE_LABELS[t] ?? t };
      },
      { kind: 'plain' }
    ).filter(g => g.key !== 'stype:'),   // 无 source 的文章不进此维度
  },
];
---

<BaseLayout
  title="徽章 · Vibe Reading"
  description={`按分类/来源/review/源类型分组的 ${totalArticles} 篇文章`}
  mainClass="padded"
>
  <ViewTabs active="badges" />

  {dimensions.map(dim => (
    <section class="dimension">
      <h2 class="dimension-title">{dim.title}</h2>
      <div class="dimension-groups">
        {dim.groups.map(g => (
          <details class="badge-group">
            <summary class="badge-group-head">
              <svg class="badge-group-chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {g.kind === 'inline' ? (
                <span class="cat-badge" style={badgeStyle(g.label)}>{g.label}</span>
              ) : g.kind === 'badge' ? (
                <span class={`origin-badge review-badge ${g.key.startsWith('origin:') ? 'group-badge-origin' : 'group-badge-review'}`}
                      data-origin={g.key.startsWith('origin:') ? g.key.slice(7) : undefined}
                      data-review-state={g.key.startsWith('review:') ? g.key.slice(7) : undefined}>{g.label}</span>
              ) : (
                <span class="group-badge group-badge-plain">{g.label}</span>
              )}
              <span class="badge-group-count">{g.count}</span>
            </summary>
            <div class="badge-group-articles">
              {g.items.map(a => <ArticleRow article={a} showBadges={false} />)}
            </div>
          </details>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .dimension { margin-bottom: 48px; }
  .dimension-title {
    font-size: 14px; font-weight: 600; letter-spacing: 0.3px;
    text-transform: uppercase; color: var(--text-dim);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .dimension-groups { display: flex; flex-direction: column; gap: 24px; }

  .badge-group-head {
    display: flex; align-items: center; gap: 8px;
    padding: 7px 10px; border-radius: 8px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
    transition: background .15s, border-color .15s;
    margin-bottom: 2px;
    list-style: none; cursor: pointer; user-select: none;
  }
  .badge-group-head::-webkit-details-marker { display: none; }
  .badge-group-head:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.12); }
  /* 文章行与组徽章严格对齐（head padding 10 + chev 18 + gap 8 = 36px） */
  .badge-group-articles { padding-left: 36px; }
  /* 徽章语境下的紧凑单行：分组头已表达分类，隐藏行内 meta 徽章 */
  .badge-group-articles :global(.article-item) { padding: 6px 0; }
  .badge-group-articles :global(.article-item-meta) { display: none; }
  /* star 徽章例外：可见（好文信号）。:global 防 scoped 编译破坏 :has 匹配 */
  .badge-group-articles :global(.article-item-meta:has(.star-badge)) {
    display: flex; margin-top: 2px;
  }
  .badge-group-chev {
    display: inline-flex; align-items: center; justify-content: center;
    width: 18px; height: 18px; flex-shrink: 0;
    color: #999;
    transition: color .15s, transform .2s cubic-bezier(0.4,0,0.2,1);
  }
  .badge-group-head:hover .badge-group-chev { color: #ccc; }
  details[open] > .badge-group-head .badge-group-chev { transform: rotate(90deg); }

  .group-badge-plain {
    font-size: 11px; font-weight: 600;
    color: var(--text-muted); background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    padding: 2px 9px; border-radius: 20px;
    letter-spacing: 0.2px; white-space: nowrap;
  }
  .badge-group-count {
    font-size: 12px; color: var(--text-dim);
    background: rgba(255,255,255,0.04);
    padding: 1px 8px; border-radius: 20px;
    white-space: nowrap;
  }
</style>

<style is:global>
  /* ── 分组头徽章：类名/着色与 ArticleBadges / article.css 同源
     （色值来自 badges.ts 注释的六色域分配），尺寸对齐分组语境 11px ── */
  .badge-group-head .cat-badge,
  .badge-group-head .origin-badge,
  .badge-group-head .review-badge {
    font-size: 11px; font-weight: 600;
    padding: 2px 9px; border-radius: 20px;
    letter-spacing: 0.2px; white-space: nowrap; cursor: default;
  }
  .badge-group-head .origin-badge[data-origin="repost"]   { color: #2dd4bf; background: rgba(45,212,191,.12);  border: 1px solid rgba(45,212,191,.30); }
  .badge-group-head .origin-badge[data-origin="original"] { color: #ff6b9d; background: rgba(255,107,157,.12);  border: 1px solid rgba(255,107,157,.30); }
  .badge-group-head .review-badge[data-review-state="pending"] { color: #ff9f0a; background: rgba(255,159,10,.12); border: 1px solid rgba(255,159,10,.30); }
  .badge-group-head .review-badge[data-review-state="reviewed"] { color: #3fb950; background: rgba(63,185,80,.12);  border: 1px solid rgba(63,185,80,.30); }
</style>
