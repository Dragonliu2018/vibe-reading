---
/**
 * 分类页面 — 展示当前分类及其子孙分类的层级关系
 *
 * URL: /categories/Database/Apache Doris/Docs
 *
 * 页面结构：
 *   1. 面包屑导航（首页 › Database › Apache Doris › Docs）
 *   2. 标题 + 文章总数
 *   3. 子分类卡片（每个直接子分类一张卡片，显示名称 + 文章数）
 *   4. 当前分类直属文章列表
 *
 * 外壳由 BaseLayout 收敛（theme="github" 保持本页的 GitHub 蓝调色）；
 * 子孙分类树由 CategorySubtree 组件递归渲染（原生 <details> 折叠）。
 */
import { articles } from '../../data/articles';
import { categoryTree, type TreeNode } from '../../data/categories';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import CategorySubtree from '../../components/CategorySubtree.astro';

export function getStaticPaths() {
  const paths: { params: { path: string }; props: { node: TreeNode; pathArray: string[] } }[] = [];

  function walk(nodes: TreeNode[], ancestors: string[] = []) {
    for (const node of nodes) {
      const pathArray = [...ancestors, node.label];
      paths.push({
        params: { path: pathArray.map(l => l.replace(/\//g, '-')).join('/') },
        props: { node, pathArray },
      });
      if (node.children) walk(node.children, pathArray);
    }
  }
  walk(categoryTree);
  return paths;
}

const { node, pathArray } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ── 递归统计子树文章总数 ──────────────────────────────────────────
function countArticles(n: TreeNode): number {
  let count = n.slugs?.length ?? 0;
  if (n.children) for (const c of n.children) count += countArticles(c);
  return count;
}

// ── 当前分类直属文章（按日期降序；title="Overview" 固定排最前）────
function getArticles(n: TreeNode) {
  return (n.slugs ?? [])
    .map(slug => articles.find(a => a.slug === slug))
    .filter(Boolean)
    .sort((a, b) => {
      if (a!.title === 'Overview') return -1;
      if (b!.title === 'Overview') return 1;
      return new Date(b!.date).getTime() - new Date(a!.date).getTime();
    });
}

const directArticles = getArticles(node);

// ── 子分类（有文章或有子分类的才显示）──────────────────────────────
const visibleChildren = (node.children ?? []).filter(c => countArticles(c) > 0);

// ── 面包屑路径 ────────────────────────────────────────────────────
function catHref(arr: string[]): string {
  return `${base}/categories/${arr.map(l => encodeURIComponent(l.replace(/\//g, '-'))).join('/')}`;
}

const totalArticles = countArticles(node);
const pageTitle = pathArray[pathArray.length - 1];
---

<BaseLayout
  title={`${pageTitle} · Vibe Reading`}
  description={`${pageTitle} 分类下的 ${totalArticles} 篇文章`}
  theme="github"
  mainClass="narrow"
>

  <!-- 面包屑 -->
  <nav class="cat-breadcrumb" aria-label="分类路径">
    <a href={`${base}/`}>首页</a>
    {pathArray.map((cat, i) => (
      <>
        <span class="bc-sep">›</span>
        {i === pathArray.length - 1 ? (
          <span class="bc-current">{cat}</span>
        ) : (
          <a href={catHref(pathArray.slice(0, i + 1))}>{cat}</a>
        )}
      </>
    ))}
  </nav>

  <!-- 标题 -->
  <div class="cat-header">
    <h1 class="cat-title">{pageTitle}</h1>
    <p class="cat-count">{totalArticles} 篇文章</p>
  </div>

  <!-- 当前分类直属文章 -->
  {directArticles.length > 0 && (
    <div class="article-section">
      <div class="article-section-title">本分类文章</div>
      {directArticles.map(article => <ArticleRow article={article!} />)}
    </div>
  )}

  <!-- 子孙分类层级树（含所有文章） -->
  {visibleChildren.length > 0 && (
    <div class="subtree-section">
      <div class="subcat-section-title">子分类</div>
      {visibleChildren.map(c => <CategorySubtree node={c} ancestors={pathArray} />)}
    </div>
  )}

  {directArticles.length === 0 && visibleChildren.length === 0 && (
    <div class="empty-state">该分类下暂无文章</div>
  )}

</BaseLayout>

<style>
  /* ── 面包屑 ── */
  .cat-breadcrumb {
    display: flex; flex-wrap: wrap; align-items: center; gap: 2px;
    font-size: 13px; color: var(--text-dim);
    margin-top: 40px; margin-bottom: 28px;
    line-height: 1.6;
  }
  .cat-breadcrumb a {
    color: var(--text-dim);
    text-decoration: none;
    transition: color .15s;
    white-space: nowrap;
  }
  .cat-breadcrumb a:hover { color: var(--text); }
  .cat-breadcrumb .bc-sep {
    margin: 0 6px; opacity: 0.4;
    font-size: 14px; font-weight: 300;
  }
  .cat-breadcrumb .bc-current {
    color: var(--text-muted); font-weight: 500;
  }

  /* ── 标题 ── */
  .cat-header { margin-bottom: 36px; }
  .cat-title {
    font-size: 28px; font-weight: 700; letter-spacing: -0.5px;
    color: var(--text); margin-bottom: 6px;
  }
  .cat-count {
    font-size: 14px; color: var(--text-dim);
  }

  /* ── 文章列表 ── */
  .article-section { margin-bottom: 40px; }
  .article-section-title {
    font-size: 14px; font-weight: 600; letter-spacing: 0.3px;
    text-transform: uppercase; color: var(--text-dim);
    margin-bottom: 14px;
  }

  .empty-state {
    text-align: center; padding: 40px 0;
    color: var(--text-dim); font-size: 14px;
  }
</style>
