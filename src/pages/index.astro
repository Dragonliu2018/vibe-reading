---
/**
 * 首页 — 文章列表视图（多视图之一，active=list）
 *
 * 外壳由 BaseLayout 收敛；文章列表按日期分页，避免一次构建和解析上千张卡片。
 */
import ArticleList from '../components/ArticleList.astro';
import { articlePageCount, articlesByDate, getArticlePage } from '../data/article-pagination';
import BaseLayout from '../layouts/BaseLayout.astro';
import ViewTabs from '../components/ViewTabs.astro';
---

<BaseLayout
  title="Vibe Reading · 技术文档解读博客"
  description="AI-drafted, human-reviewed technical reading blog — code walkthroughs and paper breakdowns."
  mainClass="padded"
>
  <ViewTabs active="list" count={articlesByDate.length} />
  <ArticleList items={getArticlePage(1)} page={1} totalPages={articlePageCount} />

  <Fragment slot="footer">
    AI-drafted · Human-reviewed &nbsp;·&nbsp;
    <a href="https://github.com/Dragonliu2018/vibe-reading" target="_blank" rel="noopener">GitHub</a>
  </Fragment>
</BaseLayout>
